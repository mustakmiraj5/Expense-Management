generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  password   String
  firstName  String
  lastName   String
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  categories Category[]
  expenses   Expense[]
  incomes    Income[]
  contacts   Contact[]
  loans      Loan[]
  repayments Repayment[]
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  icon      String?
  color     String?
  isDefault Boolean   @default(false)
  userId    Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, name])
  @@index([userId])
}

model Expense {
  id          Int      @id @default(autoincrement())
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime
  description String?
  userId      Int
  categoryId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([userId, date])
  @@index([userId, categoryId])
}

model Income {
  id          Int      @id @default(autoincrement())
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime
  description String?
  source      String?
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  note      String?
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans Loan[]

  @@unique([userId, name])
  @@index([userId])
}

enum LoanDirection {
  LENT
  BORROWED
}

enum LoanStatus {
  OPEN
  SETTLED
}

model Loan {
  id          Int           @id @default(autoincrement())
  direction   LoanDirection
  principal   Decimal       @db.Decimal(12, 2)
  date        DateTime
  dueDate     DateTime?
  description String?
  status      LoanStatus    @default(OPEN)
  userId      Int
  contactId   Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact    Contact     @relation(fields: [contactId], references: [id])
  repayments Repayment[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, direction])
  @@index([userId, dueDate])
  @@index([contactId])
}

model Repayment {
  id        Int      @id @default(autoincrement())
  loanId    Int
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  note      String?
  userId    Int
  createdAt DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([userId])
}
